# Create a new APRISM project at https://supabase.com/dashboard.
# Use only the public URL and publishable key in browser-accessible variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Trusted canonical site origin used by metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JQWKL9ZEE8

# Never add a service_role key or Supabase secret key to NEXT_PUBLIC_* variables.
