# Create a new APRISM project at https://supabase.com/dashboard.
# Use only the public URL and publishable key in browser-accessible variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase key used by verified Stripe webhooks and signed invoice downloads.
# Prefer the current sb_secret_ key. A legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Trusted canonical site origin used by metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe-hosted Checkout. Secret and webhook keys must never use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Public Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JQWKL9ZEE8

# Never add a service_role key or Supabase secret key to NEXT_PUBLIC_* variables.
